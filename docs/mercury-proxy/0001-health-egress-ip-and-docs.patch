 const MERCURY_BASE = 'https://api.mercury.com';
 
+// Real egress IP: fetched once at startup from ipify and cached. /health
+// reports this value (or null + egressError) instead of a hard-coded address.
+let egressIp = null;
+let egressError = null;
+async function detectEgressIp() {
+  try {
+    const r = await fetch('https://api.ipify.org?format=json', { signal: AbortSignal.timeout(5000) });
+    if (!r.ok) throw new Error(`ipify HTTP ${r.status}`);
+    const { ip } = await r.json();
+    if (typeof ip !== 'string' || !ip) throw new Error('ipify returned no ip');
+    egressIp = ip;
+    egressError = null;
+  } catch (err) {
+    egressError = err.message;
+  }
+  console.log(`[mercury-proxy] Egress IP: ${egressIp ?? `unknown (${egressError})`}`);
+}
